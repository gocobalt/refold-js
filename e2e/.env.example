# DEV-7914 e2e — environment for running the connect cases against a real Refold target.
# Copy to e2e/.env (gitignored) and fill in. The harness smoke test (harness.spec.ts) needs NONE of
# these; they are only for the connect cases.

# --- Tier 1: Refold access (needed for every case) ---
REFOLD_BASE_URL=https://uat.refold.ai
REFOLD_ENVIRONMENT=test
# Org API key, used server-side to mint a session token (same value as the automations UAT_API_KEY).
REFOLD_API_KEY=
REFOLD_LINKED_ACCOUNT=cobalt_test_user

# --- Jira (the target app) ---
JIRA_CONNECT_SLUG=jira
# Jira's required connect field (site_name): your Atlassian site, e.g. acme -> acme.atlassian.net
JIRA_SITE_NAME=
# Atlassian test account for the consent cases (one account covers both Jira and Confluence):
ATLASSIAN_EMAIL=
ATLASSIAN_PASSWORD=
# ATLASSIAN_TOTP_SECRET=   # only if the account enforces TOTP MFA

# --- Key-based connect (case 14): Monday API token ---
# A QA-controlled Monday access token (same value as the automations suite's UAT_MONDAY_API_KEY).
# Only the valid-credentials half of case 14 needs it; the bad-credentials half runs without it.
MONDAY_API_KEY=

# --- Client-credentials connect (case 13): Auth0 M2M app ---
# From an Auth0 Machine-to-Machine app authorized for the Auth0 Management API.
# base_url is the tenant URL, e.g. https://dev-ab12cd34.us.auth0.com (no trailing slash).
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_BASE_URL=
