# DEV-7914 e2e — environment for running the connect cases against a real Refold target.
# Copy to e2e/.env (gitignored) and fill in. The harness smoke test (harness.spec.ts) needs NONE of
# these; they are only for the 22 connect cases.

# --- Tier 1: Refold access (needed for every real case) -----------------------------------------
# Target environment the SDK connects to (uat | release | prod → app host).
REFOLD_BASE_URL=https://uat.refold.ai
# Value stamped in the `environment` request header (test for UAT/release).
REFOLD_ENVIRONMENT=test
# Org API key, used server-side to mint a session token for the linked account
# (POST /api/v2/public/session-token). Same value as the automations suite's UAT_API_KEY.
REFOLD_API_KEY=
# Linked account the SDK connects apps onto.
REFOLD_LINKED_ACCOUNT=cobalt_test_user

# --- Tier 2: provider account (only for the "connection becomes active" cases: 1, 3, 13, 14, 16, 17, 21) ---
# The app under test. Leave unset to run only the Tier-1 cases (9, 12, and the close/timeout/abort ones).
REFOLD_CONNECT_SLUG=
# Provider login for the chosen app's consent screen — keys depend on the app. Example for
# Confluence/Atlassian (a real Atlassian test account + a site):
# ATLASSIAN_EMAIL=
# ATLASSIAN_PASSWORD=
# ATLASSIAN_SITE=
# For a key-based app (case 14), the provider API credentials instead, e.g.:
# PROVIDER_API_KEY=
